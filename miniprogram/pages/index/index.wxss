.page-shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.scene-shade {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
}

.scene-background { position: fixed; z-index: 0; top: 0; }
.scene-shade { z-index: 1; background: rgba(2, 8, 17, .66); }
.scene-figurine {
  position: fixed;
  z-index: 2;
  transform: scaleX(-1);
  filter: brightness(.78) saturate(.85) drop-shadow(0 2px 5px rgba(0, 0, 0, .65));
  pointer-events: none;
}
.scene-lettering {
  position: fixed;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: rgba(213, 229, 241, .82);
  font-size: 33px;
  font-weight: 650;
  line-height: 44px;
  letter-spacing: 2px;
  text-align: center;
  text-shadow: 0 0 8px rgba(192, 217, 238, .3);
  transform: skewY(-5deg);
  pointer-events: none;
}

.content {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 100rpx) 32rpx calc(30rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.header { display: flex; align-items: center; justify-content: space-between; }
.brand { display: flex; align-items: center; gap: 20rpx; font-size: 41rpx; font-weight: 800; }
.brand-mark { width: 82rpx; height: 82rpx; border-radius: 24rpx; box-shadow: 0 0 38rpx rgba(215,255,63,.18); }

.settings-button {
  margin: 0;
  min-width: 132rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(210,229,255,.22);
  border-radius: 24rpx;
  background: rgba(8,17,31,.78);
  color: #f8fbff;
  font-size: 28rpx;
  font-weight: 700;
}

.hero { padding-top: 80rpx; }
.status { display: flex; align-items: center; gap: 18rpx; color: #d7ff3f; font-size: 29rpx; font-weight: 800; letter-spacing: 2rpx; }
.pulse { width: 18rpx; height: 18rpx; border-radius: 50%; background: currentColor; }
.pulse-active { animation: pulse 1.7s infinite; }
@keyframes pulse { 70% { box-shadow: 0 0 0 22rpx rgba(215,255,63,0); } }

.eyebrow { margin-top: 64rpx; color: #becada; font-size: 31rpx; }
.countdown { margin-top: 16rpx; color: #fff; font-size: 135rpx; line-height: .9; letter-spacing: -8rpx; font-weight: 800; text-shadow: 0 12rpx 54rpx rgba(0,0,0,.35); }
.countdown-compact { font-size: 135rpx; letter-spacing: -8rpx; }
.earning-block { margin-top: 54rpx; }
.earned-label { color: #becada; font-size: 33rpx; }
.earned { margin-top: 5rpx; color: #d7ff3f; font-size: 105rpx; line-height: .95; font-weight: 800; letter-spacing: -5rpx; text-shadow: 0 0 30rpx rgba(215,255,63,.18); }
.per-second { margin-top: 14rpx; color: #c6d1df; font-size: 33rpx; }
.per-second text { color: #d7ff3f; font-weight: 700; }

.journey { margin-top: 300rpx; padding: 172rpx 60rpx 0; }
.track-wrap { position: relative; height: 82rpx; }
.track { position: absolute; inset: 0; height: 74rpx; overflow: hidden; border: 1rpx solid rgba(192,216,255,.3); border-radius: 26rpx; background: rgba(21,31,48,.84); box-shadow: inset 0 2rpx 4rpx rgba(0,0,0,.45), 0 12rpx 28rpx rgba(0,0,0,.35); }
.progress { height: 100%; border-radius: 18rpx 0 0 18rpx; background: linear-gradient(90deg,#d8ff3e,#b6ff42); box-shadow: 0 0 35rpx rgba(215,255,63,.7); transition: width .6s ease; }
.track-dashes { position: absolute; z-index: 2; left: 18rpx; right: 18rpx; top: 35rpx; height: 4rpx; display: flex; align-items: center; justify-content: space-around; overflow: hidden; }
.track-dash { flex: 0 0 38rpx; height: 4rpx; border-radius: 4rpx; background: rgba(235,244,255,.7); box-shadow: 0 1rpx 2rpx rgba(0,0,0,.28); }
.finish-point { position: absolute; z-index: 5; right: 0; top: 37rpx; box-sizing: border-box; width: 36rpx; height: 36rpx; transform: translate(50%, -50%); border: 6rpx solid #fff; border-radius: 50%; background: #d7ff3f; box-shadow: 0 0 0 10rpx rgba(215,255,63,.12), 0 0 25rpx rgba(215,255,63,.65); }
.finish-flag { position: absolute; z-index: 4; left: calc(100% - 32rpx); bottom: 8rpx; width: 120rpx; height: 120rpx; }
.mascot { position: absolute; bottom: 14rpx; width: 216rpx; height: 196rpx; transform: translateX(-48%); transition: left .6s ease; }
.mascot-image { position: relative; z-index: 2; width: 100%; height: 100%; filter: drop-shadow(0 20rpx 15rpx rgba(0,0,0,.5)); }
.mascot-trail { position: absolute; z-index: 1; left: -70rpx; bottom: 0; width: 150rpx; height: 76rpx; opacity: 0; }
.trail-visible { opacity: .42; animation: trail .5s ease-in-out infinite alternate; }
.celebrate { animation: celebrate .48s ease-in-out infinite alternate; }
.mascot-note { position: absolute; z-index: 3; left: 50%; bottom: 170rpx; min-width: 190rpx; padding: 14rpx 18rpx; transform: translate(-50%, 12rpx); opacity: 0; border: 1rpx solid rgba(215,255,63,.4); border-radius: 18rpx; background: rgba(7,17,31,.96); color: #d7ff3f; font-size: 23rpx; font-weight: 700; text-align: center; white-space: nowrap; transition: all .18s ease; }
.note-visible { opacity: 1; transform: translate(-50%, 0); }
@keyframes trail { to { transform: translateX(-10rpx) scale(1.05); opacity: .5; } }
@keyframes celebrate { from { transform: rotate(-4deg); } to { transform: translateY(-14rpx) rotate(4deg); } }

.journey-labels { margin-top: 34rpx; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; color: #d8e1ec; font-size: 25rpx; }
.journey-labels > view:last-child { text-align: right; }
.journey-labels text { margin-left: 8rpx; color: #9cabc0; }
.progress-readout { color: #f8fbff; }
.progress-readout text { color: #d7ff3f; font-weight: 800; }
.footnote { margin: 38rpx auto 0; color: rgba(210,222,237,.7); font-size: 22rpx; text-align: center; }

.modal-backdrop { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(2,7,14,.76); }
.settings-panel { box-sizing: border-box; width: 100%; max-height: 88vh; overflow-y: auto; padding: 38rpx 34rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; border-top: 1rpx solid rgba(224,239,255,.34); background: #0c1625; box-shadow: 0 -24rpx 80rpx rgba(0,0,0,.5); }
.settings-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 36rpx; }
.settings-title { font-size: 35rpx; font-weight: 800; }
.close-button { margin: 0; width: 88rpx; height: 88rpx; line-height: 80rpx; padding: 0; border: 1rpx solid rgba(210,229,255,.2); border-radius: 22rpx; background: #07111f; color: #f8fbff; font-size: 42rpx; }
.field { margin-bottom: 28rpx; }
.label { display: block; margin-bottom: 14rpx; color: #cad4e1; font-size: 26rpx; }
.salary-input, .picker-value { box-sizing: border-box; min-height: 88rpx; border: 1rpx solid rgba(210,229,255,.16); border-radius: 22rpx; background: #07111f; color: #f8fbff; }
.salary-input { display: flex; align-items: center; padding: 0 24rpx; color: #9cabc0; }
.salary-input input { flex: 1; height: 86rpx; margin-left: 12rpx; color: #f8fbff; }
.picker-value { display: flex; align-items: center; padding: 0 24rpx; font-size: 28rpx; }
.picker-arrow::after { content: "›"; margin-left: auto; color: #9cabc0; transform: rotate(90deg); }
.time-row { display: flex; gap: 18rpx; }
.time-field { flex: 1; }
.rates { margin-top: 10rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(210,229,255,.16); }
.rates view { display: flex; justify-content: space-between; padding: 13rpx 0; color: #9cabc0; font-size: 25rpx; }
.rates view text:last-child { color: #f8fbff; font-weight: 700; }
.save-button { margin-top: 28rpx; height: 92rpx; line-height: 92rpx; border-radius: 24rpx; background: #d7ff3f; color: #07111f; font-size: 29rpx; font-weight: 800; }

@media (min-width: 600px) {
  .content { max-width: 1000rpx; margin: 0 auto; }
  .countdown { font-size: 132rpx; }
  .settings-panel { max-width: 760rpx; margin: 0 auto; border-radius: 36rpx 36rpx 0 0; }
}
